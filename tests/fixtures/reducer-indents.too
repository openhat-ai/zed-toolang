flow combine:
  reduce using merge:
    initial:
      Named initial content.
  run after_named
  reduce:
    Merge the results.
    initial:
      Inline initial content.
  run after_inline
  reduce:
    Merge the results.
    initial: Same-line initializer.
  run after_same_line
  reduce using merge:
    initial:
      Final initial content.
